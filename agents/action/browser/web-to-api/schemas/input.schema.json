{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afe://browser/web-to-api/input",
  "type": "object",
  "required": [
    "input"
  ],
  "properties": {
    "input": {
      "type": "string",
      "description": "Primary task payload (site + workflows \u2192 tool definitions)"
    },
    "locale": {
      "type": "string",
      "default": "en"
    },
    "context": {
      "type": "object"
    },
    "execute": {
      "type": "boolean",
      "default": false
    }
  }
}
