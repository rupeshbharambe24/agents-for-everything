{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afe://hr/interview-kit-builder/input",
  "type": "object",
  "required": [
    "input"
  ],
  "properties": {
    "input": {
      "type": "string",
      "description": "Primary task payload (role \u2192 kit)"
    },
    "locale": {
      "type": "string",
      "default": "en"
    },
    "context": {
      "type": "object"
    },
    "execute": {
      "type": "boolean",
      "default": false
    }
  }
}
