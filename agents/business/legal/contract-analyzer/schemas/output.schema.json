{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afe://legal/contract-analyzer/output",
  "type": "object",
  "required": [
    "flagged_clauses",
    "risk_level"
  ],
  "properties": {
    "flagged_clauses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}
