{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "text",
    "tone"
  ],
  "properties": {
    "text": {
      "type": "string"
    },
    "tone": {
      "enum": [
        "executive",
        "friendly",
        "concise",
        "formal",
        "plain"
      ]
    }
  }
}
