{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afe://guardrails/content-moderator/output",
  "type": "object",
  "required": [
    "allowed",
    "labels",
    "action"
  ],
  "properties": {
    "allowed": {
      "type": "boolean"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action": {
      "enum": [
        "allow",
        "warn",
        "block"
      ]
    }
  }
}
