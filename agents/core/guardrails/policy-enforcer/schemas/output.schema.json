{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afe://guardrails/policy-enforcer/output",
  "type": "object",
  "required": [
    "decision",
    "reason"
  ],
  "properties": {
    "decision": {
      "enum": [
        "allow",
        "deny",
        "approve"
      ]
    },
    "reason": {
      "type": "string"
    }
  }
}
