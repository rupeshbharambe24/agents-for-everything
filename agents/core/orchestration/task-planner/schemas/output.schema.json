{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afe://orchestration/task-planner/output",
  "type": "object",
  "required": [
    "steps",
    "estimated_cost_usd"
  ],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "estimated_cost_usd": {
      "type": "number",
      "minimum": 0
    }
  }
}
