{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afe://orchestration/supervisor/output",
  "type": "object",
  "required": [
    "results",
    "run_log",
    "status"
  ],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "run_log": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ]
    }
  }
}
