{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afe://coding/pr-describer/output",
  "type": "object",
  "required": [
    "title",
    "summary",
    "changelog"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
