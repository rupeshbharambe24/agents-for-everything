    "mean",
    "min",
    "max",
    "insight"
  ],
  "properties": {
    "count": {
      "type": "integer"
    },
    "mean": {
      "type": "number"
    },
    "min": {
      "type": "number"
    },
    "max": {
      "type": "number"
    },
    "insight": {
      "type": "string"
    }
  }
}
