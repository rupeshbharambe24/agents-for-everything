{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afe://types/FormSchema",
  "title": "FormSchema",
  "type": "object",
  "required": ["id", "fields"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "locale": { "type": "string" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "type"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "type": {
            "enum": ["string", "number", "integer", "boolean", "date", "email", "phone", "enum", "address"]
          },
          "required": { "type": "boolean", "default": false },
          "pattern": { "type": "string" },
          "enum": { "type": "array", "items": { "type": "string" } },
          "help_text": { "type": "string" }
        }
      }
    }
  }
}
