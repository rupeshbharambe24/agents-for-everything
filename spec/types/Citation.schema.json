{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afe://types/Citation",
  "title": "Citation",
  "type": "object",
  "required": ["source_id"],
  "properties": {
    "source_id": { "type": "string" },
    "title": { "type": "string" },
    "url": { "type": "string" },
    "quote": { "type": "string" },
    "page": { "type": "integer", "minimum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
