{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afe://types/Transcript",
  "title": "Transcript",
  "type": "object",
  "required": ["text"],
  "properties": {
    "text": { "type": "string" },
    "language": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "start_ms": { "type": "number", "minimum": 0 },
          "end_ms": { "type": "number", "minimum": 0 },
          "speaker": { "type": "string" },
          "text": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
